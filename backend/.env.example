# Conexão com o MongoDB
MONGO_URI=mongodb://localhost:27017/barbearia

# Chave secreta da sessão — use no mínimo 32 caracteres aleatórios
SESSION_SECRET=substitua_por_uma_chave_longa_e_aleatoria_aqui

# Senha do usuário admin criado automaticamente na primeira execução
ADMIN_SENHA=sua_senha_aqui

# URL do frontend (usado pelo CORS)
FRONTEND_URL=http://localhost:5173

# Porta do servidor backend
PORT=3000
