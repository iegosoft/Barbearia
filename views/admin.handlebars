<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel de Agendamentos</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />
</head>
<body>
  <div class="sidebar">
    <img src="/img/logo2.png" alt="Logo Barbearia" class="logo2" />
    <ul>
      <li><a href="/"><i class="bi bi-house"></i> Início</a></li>
      <li><a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> Sair</a></li>
    </ul>
  </div>

  <div class="main">
    <header>
      <h1><i class="bi bi-calendar-check"></i> Painel de Agendamentos</h1>
      <a class="logout" href="/admin/logout">Sair</a>
    </header>

    <div class="content">
      {{#if agendamentos.length}}
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Data</th>
            <th>Hora</th>
            <th>Serviço</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          {{#each agendamentos}}
          <tr>
            <td>{{this.nome}}</td>
            <td>{{this.telefone}}</td>
            <td>{{this.data}}</td>
            <td>{{this.hora}}</td>
            <td>{{this.servico}}</td>
            <td>
              <div class="acoes-botoes">
                <form action="/admin/remover/{{this._id}}" method="POST" style="display:inline;">
                  <button type="submit"><i class="bi bi-trash"></i> Remover</button>
                </form>
                <form action="/admin/editar/{{this._id}}" method="GET" style="display:inline;">
                  <button type="submit"><i class="bi bi-pencil-square"></i> Editar</button>
                </form>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="no-data">Nenhum agendamento encontrado.</p>
      {{/if}}
    </div>
  </div>
</body>
</html>
