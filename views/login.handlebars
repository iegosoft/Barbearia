<link rel="stylesheet" href="/css/login.css">

<div class="login-page">
  <div class="login-box">
    <h1 class="login-title">Login BarberShop</h1>
    <img src="/img/logo2.png" alt="Logo Barbearia" class="logo2" />

    {{#if erro}}
      <p class="login-error">{{erro}}</p>
    {{/if}}

    <form action="/admin/login" method="POST" class="login-form">
      <input 
        type="text" 
        name="usuario" 
        placeholder="Usuário" 
        required 
        class="login-input"
      >
      <input 
        type="password" 
        name="senha" 
        placeholder="Senha" 
        required 
        class="login-input"
      >
      <button type="submit" class="login-button">Entrar</button>
    </form>
  </div>
</div>

