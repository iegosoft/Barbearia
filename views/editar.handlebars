<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>Editar Agendamento</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body>
  <div class="main">
    <header>
      <h1><i class="bi bi-pencil-square"></i> Editar Agendamento</h1>
    </header>

    <div class="content">
      <form action="/admin/editar/{{agendamento._id}}" method="POST" class="form-agendamento">
        <input type="text" name="nome" placeholder="Nome completo" value="{{agendamento.nome}}" required />
        <input type="text" name="telefone" placeholder="Telefone" value="{{agendamento.telefone}}" required />
        <input type="date" name="data" value="{{agendamento.data}}" required />
        <input type="time" name="hora" value="{{agendamento.hora}}" required />

        <select name="servico" required>
          <option value="">Selecione um serviço</option>
          <option value="Corte" {{#if (eq agendamento.servico "Corte")}}selected{{/if}}>Corte - R$30</option>
          <option value="Barba" {{#if (eq agendamento.servico "Barba")}}selected{{/if}}>Barba - R$20</option>
          <option value="Corte + Barba" {{#if (eq agendamento.servico "Corte + Barba")}}selected{{/if}}>Corte + Barba - R$45</option>
        </select>

        <button type="submit"><i class="bi bi-save"></i> Salvar Alterações</button>
      </form>
    </div>
  </div>
</body>
</html>
